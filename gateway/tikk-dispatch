#!/usr/bin/env python3
"""tikk-dispatch — forced-command entry for tikk's dedicated ssh key.

Enroll the Linux client's public key on the Mac as

    restrict,command="$HOME/.tikk/bin/tikk-dispatch",from="<client-ip>" ssh-ed25519 AAAA…

so that key can run exactly the tikk verbs and nothing else: no shell, no
forwarding, no pty, no paths. sshd hands us the client's requested command in
SSH_ORIGINAL_COMMAND; we split it like a shell would and exec tikk-reminders
directly (argv list, never a shell). The verb allowlist lives here, so a bug
in tikk-reminders' argument parsing can never widen what the key may do.

Modelled on blip-dispatch (nixfred/blip, MIT).
"""
import os
import shlex
import sys

VERBS = {"lists", "show", "add", "complete", "uncomplete", "delete", "check"}


def refuse(msg):
    sys.stderr.write("tikk-dispatch: %s\n" % msg)
    sys.exit(64)  # EX_USAGE


def main():
    raw = os.environ.get("SSH_ORIGINAL_COMMAND", "").strip()
    if not raw:
        refuse("this key only runs tikk verbs (no shell); try: ping, " + ", ".join(sorted(VERBS)))
    try:
        argv = shlex.split(raw)
    except ValueError as e:
        refuse("unparseable command: %s" % e)
    if not argv:
        refuse("empty command")
    if argv == ["ping"]:  # connectivity probe, no AppleScript involved
        print("pong")
        return
    words = [a for a in argv if a != "--json"]  # --json may lead or trail the verb
    verb = words[0] if words else ""
    if verb not in VERBS:
        refuse("'%s' is not a tikk verb" % verb)
    bindir = os.path.dirname(os.path.realpath(__file__))
    # Fixed, system-only PATH: nothing user-writable can shadow osascript/pkill/open.
    os.environ["PATH"] = "/usr/bin:/bin:/usr/sbin:/sbin"
    os.execv(sys.executable, [sys.executable, os.path.join(bindir, "tikk-reminders")] + argv)


if __name__ == "__main__":
    main()
