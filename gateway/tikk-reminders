#!/usr/bin/env python3
"""tikk-reminders — the verbs behind tikk's SSH gateway (EventKit backend).

Runs on the Mac, called by tikk-dispatch. Talks to Reminders through
`reminders` (keith/reminders-cli, `brew install keith/formulae/reminders-cli`),
which uses EventKit directly: no Reminders.app involvement, every verb answers
in well under a second, and shared lists work.

Permission: the ssh session's TCC identity needs the *Reminders* grant. On
current macOS that grant appears together with the Automation → Reminders
grant that an `osascript` call from the same ssh session prompts for (the
prompt shows on the Mac's screen; click Allow there or via Screen Sharing).
`tikk-reminders check` tells you whether it is in place.

Output: plain text for humans, `--json` for clients. Dates are converted to
the Mac's local time zone; a due date at local midnight is reported as all-day.

Python 3.9 compatible (that is what ships with Xcode CLT).
"""
import argparse
import datetime as dt
import glob
import json
import os
import plistlib
import sqlite3
import subprocess
import sys
import time

# Looked up in this order; nothing user-writable earlier than the tool itself.
CANDIDATES = [
    os.path.join(os.path.dirname(os.path.realpath(__file__)), "reminders"),
    "/opt/homebrew/bin/reminders",
    "/usr/local/bin/reminders",
]
PROC_TIMEOUT = 30

# sysexits.h
EX_USAGE, EX_DATAERR, EX_NOINPUT, EX_UNAVAILABLE, EX_NOPERM, EX_CONFIG = 64, 65, 66, 69, 77, 78

PRIORITY_NAMES = {0: "none", 1: "high", 5: "medium", 9: "low"}


class ToolError(Exception):
    def __init__(self, code, message):
        Exception.__init__(self, message)
        self.code = code


# ---- list metadata EventKit does not expose: groups, colours, emblems, sharing.
# Read straight from Reminders' Core Data store, opened read-only in place
# (`mode=ro`: sqlite takes a shared lock and reads the WAL, so the data is
# current and nothing is written). If that fails we retry with `immutable=1`,
# which reads the main file without locks and may lag behind the WAL. Needs
# Full Disk Access for the ssh session; without it, or if Apple changes the
# schema, we return {} and the client shows a flat list.
STORE_GLOB = os.path.expanduser("~/Library/Group Containers/group.com.apple.reminders/Container_v1/Stores/Data-*.sqlite")


def plist_color(blob):
    """ZCOLOR is an NSKeyedArchiver plist holding red/green/blue floats; → '#rrggbb' or None."""
    try:
        for o in plistlib.loads(blob).get("$objects", []):
            if isinstance(o, dict) and all(k in o for k in ("red", "green", "blue")):
                return "#%02x%02x%02x" % tuple(int(round(max(0.0, min(1.0, float(o[k]))) * 255)) for k in ("red", "green", "blue"))
    except Exception:
        pass
    return None


def emblem_of(raw):
    """ZBADGEEMBLEM is either a symbolic name ('shopping1', 'default') or JSON {"Emoji": "💪"}."""
    if not raw:
        return None
    try:
        j = json.loads(raw)
        if isinstance(j, dict) and j.get("Emoji"):
            return j["Emoji"]
    except ValueError:
        pass
    return str(raw)


STORE_QUERY = ("select Z_PK, ZISGROUP, ZNAME, ZPARENTLIST, ZDADISPLAYORDER, ZBADGEEMBLEM, ZSHARINGSTATUS, ZCOLOR "
               "from ZREMCDBASELIST where ZMARKEDFORDELETION=0 and ZNAME is not null and ZISGROUP is not null")


def store_rows(store):
    for params in ("mode=ro", "mode=ro&immutable=1"):
        try:
            con = sqlite3.connect("file:%s?%s" % (store, params), uri=True, timeout=1.0)
            try:
                return con.execute(STORE_QUERY).fetchall()
            finally:
                con.close()
        except sqlite3.Error:
            continue
    return []


def store_meta():
    """→ {"lists": {name: {group, color, emblem, shared, order}}, "groups": [{name, order}]}"""
    meta = {"lists": {}, "groups": []}
    for store in sorted(glob.glob(STORE_GLOB)):
        rows = store_rows(store)
        by_pk = {r[0]: r for r in rows}
        for pk, isgroup, name, parent, order, emblem, shared, color in rows:
            if isgroup:
                meta["groups"].append({"name": name, "order": order or 0})
            else:
                meta["lists"][name] = {
                    "group": by_pk[parent][2] if parent in by_pk else None,
                    "color": plist_color(color) if color else None,
                    "emblem": emblem_of(emblem),
                    "shared": bool(shared),
                    "order": order or 0,
                }
    meta["groups"].sort(key=lambda g: g["order"])
    return meta


def find_tool():
    for c in CANDIDATES:
        if os.access(c, os.X_OK):
            return c
    raise ToolError(EX_CONFIG, "reminders-cli not found (looked in %s); brew install keith/formulae/reminders-cli"
                    % ", ".join(CANDIDATES))


def rem(subcommand, options=(), positionals=()):
    """Run one reminders-cli subcommand; return stdout. Maps its failure modes to exit codes.

    Options go first and positionals after a literal "--", so a list or
    reminder called "--format" or "-h" is data, never a flag. Option values
    use the --name=value form for the same reason.
    """
    cmd = [find_tool(), subcommand] + list(options) + ["--"] + list(positionals)
    try:
        p = subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True,
                           encoding="utf-8", errors="replace", timeout=PROC_TIMEOUT)
    except subprocess.TimeoutExpired:
        raise ToolError(EX_UNAVAILABLE, "reminders-cli did not return within %ds" % PROC_TIMEOUT)
    if p.returncode == 0:
        return p.stdout
    err = (p.stderr or p.stdout).strip()
    low = err.lower()
    if "grant" in low and "access" in low:
        raise ToolError(EX_NOPERM, "no Reminders access for this session: %s. Trigger the grant once with an "
                        "osascript call to Reminders from the same ssh session and click Allow on the Mac" % err)
    if "no reminders list matching" in low:
        raise ToolError(EX_NOINPUT, err)
    if "no reminder at index" in low:
        raise ToolError(EX_NOINPUT, err)
    raise ToolError(EX_UNAVAILABLE, err or "reminders-cli failed with exit %d" % p.returncode)


def rem_json(subcommand, options=(), positionals=()):
    out = rem(subcommand, list(options) + ["--format=json"], positionals)
    try:
        return json.loads(out)
    except ValueError:
        raise ToolError(EX_UNAVAILABLE, "reminders-cli returned non-JSON output")


def local_iso(utc_iso):
    """'2026-09-10T16:00:00Z' → ('2026-09-10T18:00:00+02:00', allday?) in the Mac's zone.

    Tolerates fractional seconds and a numeric offset; anything unparseable
    comes back as (None, False) rather than failing the whole verb.
    """
    if not utc_iso:
        return None, False
    s = str(utc_iso).strip()
    if s.endswith("Z"):
        s = s[:-1] + "+00:00"
    try:
        d = dt.datetime.fromisoformat(s)
    except ValueError:
        return None, False
    if d.tzinfo is None:
        d = d.replace(tzinfo=dt.timezone.utc)
    d = d.astimezone()
    return d.isoformat(timespec="seconds"), (d.hour, d.minute, d.second) == (0, 0, 0)


def normalize(r):
    if not isinstance(r, dict) or "externalId" not in r or "title" not in r:
        raise ToolError(EX_UNAVAILABLE, "reminders-cli returned a record without externalId/title")
    due, allday = local_iso(r.get("dueDate"))
    done, _ = local_iso(r.get("completionDate"))
    return {
        "id": r["externalId"],
        "name": r["title"],
        "body": r.get("notes") or None,
        "due": due,
        "allday": allday,
        "priority": r.get("priority", 0),
        "completed": bool(r.get("isCompleted")),
        "completed_at": done,
        "list": r.get("list"),
    }


def fetch(list_name, mode):
    flags = {"open": [], "done": ["--only-completed"], "all": ["--include-completed"]}[mode]
    return [normalize(r) for r in rem_json("show", flags, [list_name])]


def resolve(list_name, key, mode):
    """Accept an id (UUID or x-apple-reminder://UUID) or an exact name; return the matching record."""
    if key.startswith("x-apple-reminder://"):
        key = key[len("x-apple-reminder://"):]
    rs = fetch(list_name, mode)
    what = "" if mode == "all" else mode + " "
    if len(key) == 36 and key.count("-") == 4:
        hits = [r for r in rs if r["id"].upper() == key.upper()]
        if not hits:
            raise ToolError(EX_NOINPUT, "no %sreminder with id %s in %s" % (what, key, list_name))
        return hits[0]
    hits = [r for r in rs if r["name"] == key]
    if not hits:
        raise ToolError(EX_NOINPUT, "no %sreminder named %r in %s" % (what, key, list_name))
    if len(hits) > 1:
        raise ToolError(EX_DATAERR, "ambiguous: %d reminders named %r in %s; use the id" % (len(hits), key, list_name))
    return hits[0]


def parse_due(s):
    """Validate 'YYYY-MM-DD' or 'YYYY-MM-DD HH:MM' and hand reminders-cli the same string."""
    s = s.strip().replace("T", " ")
    for fmt in ("%Y-%m-%d %H:%M", "%Y-%m-%d"):
        try:
            dt.datetime.strptime(s, fmt)
            return s
        except ValueError:
            continue
    raise ValueError("due must be YYYY-MM-DD or 'YYYY-MM-DD HH:MM', got %r" % s)


def print_reminders(rs):
    for r in rs:
        box = "☑" if r["completed"] else "☐"
        pri = {1: " !!!", 5: " !!", 9: " !"}.get(r["priority"], "")
        line = "%s %s%s" % (box, r["name"], pri)
        if r["due"]:
            line += "  (%s)" % (r["due"][:10] if r["allday"] else r["due"][:16].replace("T", " "))
        print(line)
        if r["body"]:
            for bl in r["body"].splitlines():
                print("    %s" % bl)
        print("    %s" % r["id"])


class Parser(argparse.ArgumentParser):
    """argparse exits 2 on bad usage; the gateway speaks sysexits (64)."""
    def error(self, message):
        sys.stderr.write("tikk: %s\n" % message)
        sys.exit(EX_USAGE)


def main(argv):
    want_json = "--json" in argv  # accepted anywhere: "--json show L" and "show L --json"
    argv = [x for x in argv if x != "--json"]

    ap = Parser(prog="tikk-reminders", description=__doc__.splitlines()[0],
                epilog="Names that start with '-' go after a literal '--', e.g.: add Groceries -- '-dash first'")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    sub = ap.add_subparsers(dest="verb", required=True)
    sub.add_parser("lists", help="names of all reminder lists")
    sub.add_parser("snapshot", help="every list with its open count, plus every open reminder, in one call")
    sub.add_parser("check", help="verify the backend answers and the Reminders grant is in place")
    p = sub.add_parser("show", help="reminders in a list (open ones by default)")
    p.add_argument("list")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--all", action="store_true", help="include completed reminders")
    g.add_argument("--done", action="store_true", help="only completed reminders")
    p = sub.add_parser("add", help="create a reminder; prints its id")
    p.add_argument("list")
    p.add_argument("name")
    p.add_argument("--body", default="")
    p.add_argument("--due", help="YYYY-MM-DD (all-day) or 'YYYY-MM-DD HH:MM'")
    p.add_argument("--priority", type=int, default=0, choices=[0, 1, 5, 9],
                   help="0 none, 1 high, 5 medium, 9 low (Reminders' own scale)")
    for verb, mode in (("complete", "open"), ("uncomplete", "done"), ("delete", "all")):
        p = sub.add_parser(verb, help="%s a reminder by id or exact name" % verb)
        p.add_argument("list")
        p.add_argument("key")
        p.set_defaults(mode=mode)
    a = ap.parse_args(argv)
    a.json = want_json

    log = lambda m: sys.stderr.write("tikk: %s\n" % m)
    emit = lambda obj: print(json.dumps(obj, ensure_ascii=False))

    try:
        if a.verb == "lists":
            names = [n for n in rem("show-lists").splitlines() if n]
            emit(names) if a.json else print("\n".join(names))

        elif a.verb == "snapshot":
            names = [n for n in rem("show-lists").splitlines() if n]
            rs = [normalize(r) for r in rem_json("show-all")]
            counts = {}
            for r in rs:
                counts[r["list"]] = counts.get(r["list"], 0) + 1
            try:
                meta = store_meta()
            except Exception:
                meta = {"lists": {}, "groups": []}
            lists = []
            for n in names:
                m = meta["lists"].get(n, {})
                lists.append({"name": n, "open": counts.get(n, 0), "group": m.get("group"), "color": m.get("color"),
                              "emblem": m.get("emblem"), "shared": m.get("shared", False), "order": m.get("order", 0)})
            groups = [{"name": g["name"], "lists": [l["name"] for l in lists if l["group"] == g["name"]]} for g in meta["groups"]]
            snap = {"lists": lists, "groups": groups, "reminders": rs}
            if a.json:
                emit(snap)
            else:
                for l in snap["lists"]:
                    print("%-30s %d" % (l["name"], l["open"]))

        elif a.verb == "check":
            t0 = time.time()
            n = len([n for n in rem("show-lists").splitlines() if n])
            ms = int((time.time() - t0) * 1000)
            info = {"ok": True, "lists": n, "ms": ms, "backend": "eventkit", "tool": find_tool()}
            emit(info) if a.json else print("ok: %d lists in %d ms via %s" % (n, ms, info["tool"]))

        elif a.verb == "show":
            rs = fetch(a.list, "done" if a.done else ("all" if a.all else "open"))
            emit(rs) if a.json else print_reminders(rs)

        elif a.verb == "add":
            opts = ["--priority=" + PRIORITY_NAMES[a.priority]]
            if a.body:
                opts.append("--notes=" + a.body)
            if a.due:
                opts.append("--due-date=" + parse_due(a.due))
            r = normalize(rem_json("add", opts, [a.list, a.name]))
            emit(r) if a.json else print(r["id"])

        else:  # complete / uncomplete / delete
            r = resolve(a.list, a.key, a.mode)
            if a.verb == "delete" and r["completed"]:
                # reminders-cli's delete only sees open reminders: uncomplete first,
                # and put it back if the delete then fails, so we never leave a
                # side effect behind on error.
                rem("uncomplete", (), [a.list, r["id"]])
                try:
                    rem("delete", (), [a.list, r["id"]])
                except ToolError:
                    rem("complete", (), [a.list, r["id"]])
                    raise
            else:
                rem(a.verb, (), [a.list, r["id"]])
            emit({"id": r["id"], a.verb + "d": True}) if a.json else print(r["id"])

    except ValueError as e:
        log(str(e))
        return EX_USAGE
    except ToolError as e:
        log(str(e))
        return e.code
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
