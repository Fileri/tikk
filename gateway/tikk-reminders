#!/usr/bin/env python3
"""tikk-reminders — the verbs behind tikk's SSH gateway (EventKit backend).

Runs on the Mac, invoked by tikk-dispatch with the verb and its arguments.
Talks to Reminders through `reminders` (keith/reminders-cli), which uses
EventKit directly: no Reminders.app involvement, every verb answers in well
under a second, and shared lists work.

Layout of this file
  1. constants, exit codes, errors
  2. gateway config (~/.tikk/config), audit log, list allowlist
  3. list metadata from Reminders' own store (groups, colours, emblems)
  4. the reminders-cli backend and record normalisation
  5. one function per verb
  6. argument parsing and main

Permission: the ssh session's TCC identity needs the *Reminders* grant. On
current macOS that grant appears together with the Automation → Reminders
grant that an `osascript` call from the same ssh session prompts for (the
prompt shows on the Mac's screen; click Allow there or via Screen Sharing).
`tikk-reminders check` tells you whether it is in place.

Output: plain text for humans, `--json` for clients. Dates are converted to
the Mac's local time zone; a due date at local midnight is reported as all-day.

Python 3.9 compatible (that is what ships with Xcode CLT). No dependencies
beyond the standard library and reminders-cli.
"""
import argparse
import datetime as dt
import glob
import json
import os
import plistlib
import sqlite3
import subprocess
import sys
import time
from typing import Any, Dict, Iterable, List, Optional, Sequence, Tuple

VERSION = "0.2.1"

# ----------------------------------------------------------------- 1. constants
# Looked up in this order; nothing user-writable earlier than the tool itself.
CANDIDATES = [
    os.path.join(os.path.dirname(os.path.realpath(__file__)), "reminders"),
    "/opt/homebrew/bin/reminders",
    "/usr/local/bin/reminders",
]
PROC_TIMEOUT = 30                         # seconds for one reminders-cli call
CONFIG_PATH = os.path.expanduser("~/.tikk/config")
DEFAULT_AUDIT = os.path.expanduser("~/.tikk/audit.log")
STORE_GLOB = os.path.expanduser(
    "~/Library/Group Containers/group.com.apple.reminders/Container_v1/Stores/Data-*.sqlite")

# sysexits.h — the exit code is the contract with the client
EX_USAGE, EX_DATAERR, EX_NOINPUT, EX_UNAVAILABLE, EX_NOPERM, EX_CONFIG = 64, 65, 66, 69, 77, 78

PRIORITY_NAMES = {0: "none", 1: "high", 5: "medium", 9: "low"}   # Reminders' own scale
WRITE_VERBS = ("add", "complete", "uncomplete", "delete")
ID_PREFIX = "x-apple-reminder://"

Record = Dict[str, Any]


class ToolError(Exception):
    """A failure with a sysexits code; main() turns it into stderr + exit status."""

    def __init__(self, code: int, message: str):
        Exception.__init__(self, message)
        self.code = code


# ---------------------------------------------------- 2. config, audit, allowlist
def read_config(path: str = CONFIG_PATH) -> Dict[str, Any]:
    """~/.tikk/config, `key = value`, parsed not sourced. Unknown keys are ignored.

      allow_lists = Groceries, Household   # the key may only see/touch these (default: all)
      allow_verbs = lists, show, snapshot, add, complete, uncomplete   # e.g. everything but delete (default: all)
      audit_log   = ~/.tikk/audit.log      # writes, failed writes, refusals (default); "off" disables
    """
    cfg: Dict[str, Any] = {"allow_lists": None, "allow_verbs": None, "audit_log": DEFAULT_AUDIT}
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError:
        return cfg
    for line in lines:
        line = line.split("#", 1)[0].strip()
        if "=" not in line:
            continue
        key, value = (x.strip() for x in line.split("=", 1))
        if key == "allow_lists":
            names = [n.strip() for n in value.split(",") if n.strip()]
            cfg["allow_lists"] = names or None
        elif key == "allow_verbs":
            verbs = [v.strip() for v in value.split(",") if v.strip()]
            cfg["allow_verbs"] = verbs or None
        elif key == "audit_log":
            cfg["audit_log"] = None if value.lower() in ("off", "no", "false", "") else os.path.expanduser(value)
    return cfg


def client_address() -> str:
    return (os.environ.get("SSH_CLIENT") or os.environ.get("SSH_CONNECTION") or "local").split()[0]


def audit(cfg: Dict[str, Any], event: str, **fields: Any) -> None:
    """Append one line to the audit log (created 0600). Never raises: logging must not break a verb."""
    path = cfg.get("audit_log")
    if not path:
        return
    parts = [dt.datetime.now().astimezone().isoformat(timespec="seconds"),
             "client=" + client_address(), "event=" + event]
    parts += ["%s=%s" % (k, json.dumps(str(v), ensure_ascii=False)) for k, v in fields.items() if v is not None]
    try:
        os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        with os.fdopen(fd, "a", encoding="utf-8") as f:
            f.write(" ".join(parts) + "\n")
    except OSError:
        pass


def allowed(cfg: Dict[str, Any], list_name: str) -> bool:
    return cfg.get("allow_lists") is None or list_name in cfg["allow_lists"]


def require_allowed(cfg: Dict[str, Any], list_name: str) -> None:
    if not allowed(cfg, list_name):
        raise ToolError(EX_NOPERM, "list %r is not in allow_lists on the gateway" % list_name)


def verb_allowed(cfg: Dict[str, Any], verb: str) -> bool:
    return verb == "check" or cfg.get("allow_verbs") is None or verb in cfg["allow_verbs"]


def require_verb(cfg: Dict[str, Any], verb: str) -> None:
    if not verb_allowed(cfg, verb):
        raise ToolError(EX_NOPERM, "verb %r is not in allow_verbs on the gateway" % verb)


# ------------------------------------------- 3. list metadata from the store
# EventKit does not expose Reminders.app's list groups, colours, emblems or
# sharing. Reminders' Core Data store does. It is opened read-only in place
# (`mode=ro`: a shared lock, the WAL is read, nothing is written); if that
# fails we retry with `immutable=1`, which needs no lock and may lag the WAL.
# Needs Full Disk Access for the ssh session; without it, or if Apple changes
# the schema, we return nothing and the client shows a flat list.
STORE_QUERY = ("select Z_PK, ZISGROUP, ZNAME, ZPARENTLIST, ZDADISPLAYORDER, ZBADGEEMBLEM, ZSHARINGSTATUS, ZCOLOR "
               "from ZREMCDBASELIST where ZMARKEDFORDELETION=0 and ZNAME is not null and ZISGROUP is not null")


def plist_color(blob: bytes) -> Optional[str]:
    """ZCOLOR is an NSKeyedArchiver plist holding red/green/blue floats → '#rrggbb'."""
    try:
        for obj in plistlib.loads(blob).get("$objects", []):
            if isinstance(obj, dict) and all(k in obj for k in ("red", "green", "blue")):
                rgb = tuple(int(round(max(0.0, min(1.0, float(obj[k]))) * 255)) for k in ("red", "green", "blue"))
                return "#%02x%02x%02x" % rgb
    except Exception:
        pass
    return None


def emblem_of(raw: Optional[str]) -> Optional[str]:
    """ZBADGEEMBLEM is a symbolic name ('shopping1', 'default') or JSON {"Emoji": "💪"} → emoji or name."""
    if not raw:
        return None
    try:
        parsed = json.loads(raw)
        if isinstance(parsed, dict) and parsed.get("Emoji"):
            return str(parsed["Emoji"])
    except ValueError:
        pass
    return str(raw)


def store_rows(store: str) -> List[Tuple]:
    for params in ("mode=ro", "mode=ro&immutable=1"):
        try:
            con = sqlite3.connect("file:%s?%s" % (store, params), uri=True, timeout=1.0)
            try:
                return con.execute(STORE_QUERY).fetchall()
            finally:
                con.close()
        except sqlite3.Error:
            continue
    return []


def store_meta(stores: Optional[Iterable[str]] = None) -> Dict[str, Any]:
    """→ {"lists": {name: {group, color, emblem, shared, order}}, "groups": [{name, order}]}"""
    meta: Dict[str, Any] = {"lists": {}, "groups": []}
    for store in sorted(stores if stores is not None else glob.glob(STORE_GLOB)):
        rows = store_rows(store)
        by_pk = {r[0]: r for r in rows}
        for pk, isgroup, name, parent, order, emblem, shared, color in rows:
            if isgroup:
                meta["groups"].append({"name": name, "order": order or 0})
            else:
                meta["lists"][name] = {
                    "group": by_pk[parent][2] if parent in by_pk else None,
                    "color": plist_color(color) if color else None,
                    "emblem": emblem_of(emblem),
                    "shared": bool(shared),
                    "order": order or 0,
                }
    meta["groups"].sort(key=lambda g: g["order"])
    return meta


# -------------------------------------------------- 4. reminders-cli backend
def find_tool() -> str:
    for candidate in CANDIDATES:
        if os.access(candidate, os.X_OK):
            return candidate
    raise ToolError(EX_CONFIG, "reminders-cli not found (looked in %s); brew install keith/formulae/reminders-cli"
                    % ", ".join(CANDIDATES))


# Substrings of reminders-cli's messages → our exit code. Checked in order.
BACKEND_ERRORS = (
    (("grant", "access"), EX_NOPERM),
    (("no reminders list matching",), EX_NOINPUT),
    (("no reminder at index",), EX_NOINPUT),
)


def rem(subcommand: str, options: Sequence[str] = (), positionals: Sequence[str] = ()) -> str:
    """Run one reminders-cli subcommand and return its stdout.

    Options go first (always --name=value) and positionals after a literal
    "--", so a list or reminder called "--format" or "-h" is data, never a
    flag. stdin is closed; output is decoded as UTF-8 with replacement.
    """
    cmd = [find_tool(), subcommand] + list(options) + ["--"] + list(positionals)
    try:
        proc = subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True,
                              encoding="utf-8", errors="replace", timeout=PROC_TIMEOUT)
    except subprocess.TimeoutExpired:
        raise ToolError(EX_UNAVAILABLE, "reminders-cli did not return within %ds" % PROC_TIMEOUT)
    if proc.returncode == 0:
        return proc.stdout
    err = (proc.stderr or proc.stdout).strip()
    low = err.lower()
    for needles, code in BACKEND_ERRORS:
        if all(n in low for n in needles):
            if code == EX_NOPERM:
                err += (". Trigger the grant once with an osascript call to Reminders from the same "
                        "ssh session and click Allow on the Mac")
            raise ToolError(code, err)
    raise ToolError(EX_UNAVAILABLE, err or "reminders-cli failed with exit %d" % proc.returncode)


def rem_json(subcommand: str, options: Sequence[str] = (), positionals: Sequence[str] = ()) -> Any:
    out = rem(subcommand, list(options) + ["--format=json"], positionals)
    try:
        return json.loads(out)
    except ValueError:
        raise ToolError(EX_UNAVAILABLE, "reminders-cli returned non-JSON output")


def local_iso(utc_iso: Optional[str]) -> Tuple[Optional[str], bool]:
    """'2026-09-10T16:00:00Z' → ('2026-09-10T18:00:00+02:00', is_allday) in the Mac's zone.

    Tolerates fractional seconds and numeric offsets; anything unparseable is
    (None, False) rather than a failed verb. All-day = local midnight, which is
    how EventKit represents date-only due dates.
    """
    if not utc_iso:
        return None, False
    text = str(utc_iso).strip()
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    try:
        d = dt.datetime.fromisoformat(text)
    except ValueError:
        return None, False
    if d.tzinfo is None:
        d = d.replace(tzinfo=dt.timezone.utc)
    d = d.astimezone()
    return d.isoformat(timespec="seconds"), (d.hour, d.minute, d.second) == (0, 0, 0)


def normalize(raw: Any) -> Record:
    """reminders-cli's JSON → tikk's stable record shape."""
    if not isinstance(raw, dict) or "externalId" not in raw or "title" not in raw:
        raise ToolError(EX_UNAVAILABLE, "reminders-cli returned a record without externalId/title")
    due, allday = local_iso(raw.get("dueDate"))
    done, _ = local_iso(raw.get("completionDate"))
    return {
        "id": raw["externalId"],
        "name": raw["title"],
        "body": raw.get("notes") or None,
        "due": due,
        "allday": allday,
        "priority": int(raw.get("priority") or 0),
        "completed": bool(raw.get("isCompleted")),
        "completed_at": done,
        "list": raw.get("list"),
    }


def list_names() -> List[str]:
    return [n for n in rem("show-lists").splitlines() if n]


def fetch(list_name: str, mode: str) -> List[Record]:
    """Reminders in one list: mode 'open' (default), 'done', or 'all'."""
    flags = {"open": [], "done": ["--only-completed"], "all": ["--include-completed"]}[mode]
    return [normalize(r) for r in rem_json("show", flags, [list_name])]


def looks_like_id(key: str) -> bool:
    return len(key) == 36 and key.count("-") == 4


def resolve(list_name: str, key: str, mode: str) -> Record:
    """Find one reminder by id (UUID, with or without x-apple-reminder://) or exact name.

    Names are matched among 'open', 'done' or 'all' reminders depending on the
    verb; an ambiguous name is refused so a keypress never hits the wrong item.
    """
    if key.startswith(ID_PREFIX):
        key = key[len(ID_PREFIX):]
    records = fetch(list_name, mode)
    scope = "" if mode == "all" else mode + " "
    if looks_like_id(key):
        hits = [r for r in records if r["id"].upper() == key.upper()]
        if not hits:
            raise ToolError(EX_NOINPUT, "no %sreminder with id %s in %s" % (scope, key, list_name))
        return hits[0]
    hits = [r for r in records if r["name"] == key]
    if not hits:
        raise ToolError(EX_NOINPUT, "no %sreminder named %r in %s" % (scope, key, list_name))
    if len(hits) > 1:
        raise ToolError(EX_DATAERR, "ambiguous: %d reminders named %r in %s; use the id" % (len(hits), key, list_name))
    return hits[0]


def parse_due(text: str) -> str:
    """Accept 'YYYY-MM-DD' (all-day) or 'YYYY-MM-DD HH:MM'; return the string reminders-cli takes."""
    text = text.strip().replace("T", " ")
    for fmt in ("%Y-%m-%d %H:%M", "%Y-%m-%d"):
        try:
            dt.datetime.strptime(text, fmt)
            return text
        except ValueError:
            continue
    raise ToolError(EX_USAGE, "due must be YYYY-MM-DD or 'YYYY-MM-DD HH:MM', got %r" % text)


# --------------------------------------------------------------- 5. the verbs
def format_reminders(records: List[Record]) -> str:
    lines = []
    for r in records:
        box = "☑" if r["completed"] else "☐"
        pri = {1: " !!!", 5: " !!", 9: " !"}.get(r["priority"], "")
        line = "%s %s%s" % (box, r["name"], pri)
        if r["due"]:
            line += "  (%s)" % (r["due"][:10] if r["allday"] else r["due"][:16].replace("T", " "))
        lines.append(line)
        if r["body"]:
            lines += ["    " + bl for bl in r["body"].splitlines()]
        lines.append("    " + r["id"])
    return "\n".join(lines)


def verb_lists(a, cfg) -> Tuple[Any, str]:
    names = [n for n in list_names() if allowed(cfg, n)]
    return names, "\n".join(names)


def verb_snapshot(a, cfg) -> Tuple[Any, str]:
    """Every allowed list with its open count, groups, and every open reminder — one round trip."""
    names = [n for n in list_names() if allowed(cfg, n)]
    records = [r for r in (normalize(x) for x in rem_json("show-all")) if allowed(cfg, r["list"])]
    counts: Dict[str, int] = {}
    for r in records:
        counts[r["list"]] = counts.get(r["list"], 0) + 1
    try:
        meta = store_meta()
    except Exception:
        meta = {"lists": {}, "groups": []}
    lists = []
    for n in names:
        m = meta["lists"].get(n, {})
        lists.append({"name": n, "open": counts.get(n, 0), "group": m.get("group"), "color": m.get("color"),
                      "emblem": m.get("emblem"), "shared": m.get("shared", False), "order": m.get("order", 0)})
    groups = [{"name": g["name"], "lists": [l["name"] for l in lists if l["group"] == g["name"]]} for g in meta["groups"]]
    groups = [g for g in groups if g["lists"]]
    snap = {"lists": lists, "groups": groups, "reminders": records}
    return snap, "\n".join("%-30s %d" % (l["name"], l["open"]) for l in lists)


def verb_check(a, cfg) -> Tuple[Any, str]:
    t0 = time.time()
    n = len([x for x in list_names() if allowed(cfg, x)])
    ms = int((time.time() - t0) * 1000)
    info = {"ok": True, "version": VERSION, "lists": n, "ms": ms, "backend": "eventkit", "tool": find_tool(),
            "store_meta": bool(store_meta()["lists"]), "allow_lists": cfg.get("allow_lists"),
            "allow_verbs": cfg.get("allow_verbs"), "audit_log": cfg.get("audit_log")}
    text = "\n".join([
        "ok: %d lists in %d ms via %s (tikk-reminders %s)" % (n, ms, info["tool"], VERSION),
        "    groups/colours from the Reminders store: %s" % ("yes" if info["store_meta"] else "no (needs Full Disk Access)"),
        "    allow_lists: %s" % (", ".join(cfg["allow_lists"]) if cfg["allow_lists"] else "all lists"),
        "    allow_verbs: %s" % (", ".join(cfg["allow_verbs"]) if cfg.get("allow_verbs") else "all verbs"),
        "    audit log: %s" % (cfg["audit_log"] or "off"),
    ])
    return info, text


def verb_show(a, cfg) -> Tuple[Any, str]:
    records = fetch(a.list, "done" if a.done else ("all" if a.all else "open"))
    return records, format_reminders(records)


def verb_add(a, cfg) -> Tuple[Any, str]:
    options = ["--priority=" + PRIORITY_NAMES[a.priority]]
    if a.body:
        options.append("--notes=" + a.body)
    if a.due:
        options.append("--due-date=" + parse_due(a.due))
    r = normalize(rem_json("add", options, [a.list, a.name]))
    audit(cfg, "add", list=a.list, id=r["id"], name=r["name"], due=r["due"], priority=r["priority"])
    return r, r["id"]


def verb_mutate(a, cfg) -> Tuple[Any, str]:
    """complete / uncomplete / delete by id or exact name."""
    r = resolve(a.list, a.key, a.mode)
    if a.verb == "delete" and r["completed"]:
        # reminders-cli's delete only sees open reminders: uncomplete first, and
        # put it back if the delete then fails, so an error leaves no side effect.
        rem("uncomplete", (), [a.list, r["id"]])
        try:
            rem("delete", (), [a.list, r["id"]])
        except ToolError:
            rem("complete", (), [a.list, r["id"]])
            raise
    else:
        rem(a.verb, (), [a.list, r["id"]])
    audit(cfg, a.verb, list=a.list, id=r["id"], name=r["name"])
    return {"id": r["id"], a.verb + "d": True}, r["id"]


VERBS = {
    "lists": verb_lists, "snapshot": verb_snapshot, "check": verb_check, "show": verb_show,
    "add": verb_add, "complete": verb_mutate, "uncomplete": verb_mutate, "delete": verb_mutate,
}


# --------------------------------------------------------- 6. CLI and main
class Parser(argparse.ArgumentParser):
    """argparse exits 2 on bad usage; the gateway speaks sysexits (64)."""

    def error(self, message):
        sys.stderr.write("tikk: %s\n" % message)
        sys.exit(EX_USAGE)


def build_parser() -> argparse.ArgumentParser:
    ap = Parser(prog="tikk-reminders", description=__doc__.splitlines()[0],
                epilog="Names that start with '-' go after a literal '--', e.g.: add Groceries -- '-dash first'")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    ap.add_argument("--version", action="version", version="tikk-reminders " + VERSION)
    sub = ap.add_subparsers(dest="verb", required=True)
    sub.add_parser("lists", help="names of all reminder lists")
    sub.add_parser("snapshot", help="every list with its open count, plus every open reminder, in one call")
    sub.add_parser("check", help="verify the backend answers and the Reminders grant is in place")
    p = sub.add_parser("show", help="reminders in a list (open ones by default)")
    p.add_argument("list")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--all", action="store_true", help="include completed reminders")
    g.add_argument("--done", action="store_true", help="only completed reminders")
    p = sub.add_parser("add", help="create a reminder; prints its id")
    p.add_argument("list")
    p.add_argument("name")
    p.add_argument("--body", default="")
    p.add_argument("--due", help="YYYY-MM-DD (all-day) or 'YYYY-MM-DD HH:MM'")
    p.add_argument("--priority", type=int, default=0, choices=sorted(PRIORITY_NAMES),
                   help="0 none, 1 high, 5 medium, 9 low (Reminders' own scale)")
    for verb, mode in (("complete", "open"), ("uncomplete", "done"), ("delete", "all")):
        p = sub.add_parser(verb, help="%s a reminder by id or exact name" % verb)
        p.add_argument("list")
        p.add_argument("key")
        p.set_defaults(mode=mode)
    return ap


def main(argv: List[str]) -> int:
    want_json = "--json" in argv            # accepted anywhere: "--json show L" and "show L --json"
    a = build_parser().parse_args([x for x in argv if x != "--json"])
    cfg = read_config()
    try:
        require_verb(cfg, a.verb)
        if hasattr(a, "list"):
            require_allowed(cfg, a.list)
        obj, text = VERBS[a.verb](a, cfg)
        print(json.dumps(obj, ensure_ascii=False) if want_json else text)
        return 0
    except ToolError as e:
        if a.verb in WRITE_VERBS:
            audit(cfg, a.verb + "-failed", list=getattr(a, "list", None),
                  key=getattr(a, "key", None) or getattr(a, "name", None), code=e.code, error=str(e)[:200])
        sys.stderr.write("tikk: %s\n" % e)
        return e.code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
